// Pure IFA: Kori Content-Addressable Build Cache (`src/cache.ifa`)
// Caches package artifacts and metadata keyed by deterministic fingerprints.

pub struct BuildCache {
    entries: String,
    count: i64
}

pub fn make_build_cache() -> BuildCache {
    return BuildCache(
        entries: "",
        count: 0
    );
}

pub fn cache_put(inout cache: BuildCache, target_key: String, fingerprint: String, artifact_path: String) {
    let entry = "[" + target_key + "|" + fingerprint + "|" + artifact_path + "];";
    cache.entries = cache.entries + entry;
    cache.count = cache.count + 1;
}

pub fn cache_get(cache: BuildCache, target_key: String) -> String {
    let needle = "[" + target_key + "|";
    let n_len = string_len(needle);
    let total_len = string_len(cache.entries);

    if total_len < n_len {
        return "";
    }

    mut i: i64 = 0;
    while i <= total_len - n_len {
        let sub = string_substr(cache.entries, i, n_len);
        if sub == needle {
            // Found target_key, find pipe and closing bracket
            let start_after_key = i + n_len;
            mut pipe2: i64 = -1;
            mut close_bracket: i64 = -1;
            mut j: i64 = start_after_key;
            while j < total_len {
                let c = string_char_at(cache.entries, j);
                if c == 124 { // '|'
                    if pipe2 < 0 {
                        pipe2 = j;
                    }
                }
                if c == 93 { // ']'
                    close_bracket = j;
                    j = total_len; // break
                }
                j = j + 1;
            }

            if pipe2 > 0 && close_bracket > pipe2 {
                let art_path = string_substr(cache.entries, pipe2 + 1, close_bracket - pipe2 - 1);
                return art_path;
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn cache_get_fingerprint(cache: BuildCache, target_key: String) -> String {
    let needle = "[" + target_key + "|";
    let n_len = string_len(needle);
    let total_len = string_len(cache.entries);

    if total_len < n_len {
        return "";
    }

    mut i: i64 = 0;
    while i <= total_len - n_len {
        let sub = string_substr(cache.entries, i, n_len);
        if sub == needle {
            let start = i + n_len;
            mut pipe2: i64 = -1;
            mut j: i64 = start;
            while j < total_len {
                if string_char_at(cache.entries, j) == 124 { // '|'
                    pipe2 = j;
                    j = total_len; // break
                }
                j = j + 1;
            }
            if pipe2 > start {
                return string_substr(cache.entries, start, pipe2 - start);
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn test_kori_cache_subsystem() -> bool {
    mut cache = make_build_cache();
    cache_put(inout cache, "lib:std", "a1b2c3d4e5f6", "target/dev/libstd.ifalib");
    cache_put(inout cache, "bin:kori", "f6e5d4c3b2a1", "target/dev/kori");

    let art_std = cache_get(cache, "lib:std");
    if art_std != "target/dev/libstd.ifalib" {
        return false;
    }

    let hash_std = cache_get_fingerprint(cache, "lib:std");
    if hash_std != "a1b2c3d4e5f6" {
        return false;
    }

    let art_bin = cache_get(cache, "bin:kori");
    if art_bin != "target/dev/kori" {
        return false;
    }

    let missing = cache_get(cache, "lib:unknown");
    if missing != "" {
        return false;
    }

    return true;
}
