// Pure IFA: Kori Autonomous CLI Entrypoint (`src/main.ifa`)

import manifest;
import resolver;
import cache;
import builder;
import crypto;
import workspace;

pub fn main() {
    println("kori: autonomous package manager for ifa (v0.1.0)");

    let t_manifest = manifest::test_kori_manifest_structure();
    if t_manifest {
        println("manifest: ok");
    } else {
        println("manifest: failed");
    }

    let t_resolver = resolver::test_kori_semver_resolver();
    if t_resolver {
        println("resolver: ok");
    } else {
        println("resolver: failed");
    }

    let t_cache = cache::test_kori_cache_subsystem();
    if t_cache {
        println("cache: ok");
    } else {
        println("cache: failed");
    }

    let t_builder = builder::test_kori_builder_orchestrator();
    if t_builder {
        println("builder: ok");
    } else {
        println("builder: failed");
    }

    let t_crypto = crypto::test_kori_crypto_signatures();
    if t_crypto {
        println("crypto: ok");
    } else {
        println("crypto: failed");
    }

    let t_workspace = workspace::test_kori_workspace_graph();
    if t_workspace {
        println("workspace: ok");
    } else {
        println("workspace: failed");
    }

    if t_manifest && t_resolver && t_cache && t_builder && t_crypto && t_workspace {
        println("kori: ALL SUBSYSTEM TESTS PASSED");
    } else {
        println("kori: TESTS FAILED");
    }
}
